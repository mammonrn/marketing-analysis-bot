# ads-analytics-bot — environment template
# คัดลอกเป็น .env บน VPS แล้วเติมค่าจริง (ห้าม commit .env)

# ─── Telegram ────────────────────────────────────────────────────────────────
# คนละ token กับ telegram-ads-bot (Project 1)
TELEGRAM_BOT_TOKEN=

# polling = ง่ายสุด ไม่ต้องแตะ Nginx เพิ่ม / webhook = ประหยัด resource กว่า
# ถ้าใช้ webhook ต้องตั้ง PUBLIC_URL + WEBHOOK_SECRET ด้วย
TELEGRAM_MODE=polling

# ─── Access control (spec §8) ────────────────────────────────────────────────
SUPER_ADMIN_TELEGRAM_ID=509832984
# ทีมที่อนุญาตเพิ่ม คั่นด้วย comma — Super Admin ถูกใส่ให้อัตโนมัติอยู่แล้ว
# เพิ่มคนใหม่ = แก้บรรทัดนี้ + pm2 restart ads-analytics-bot (ไม่ต้อง deploy โค้ดใหม่)
ALLOWED_TELEGRAM_IDS=

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4096

# ─── HTTP / Mini App ─────────────────────────────────────────────────────────
# Nginx ที่มีอยู่แล้ว proxy มาที่ port นี้
PORT=3001
BIND_HOST=127.0.0.1

# โดเมนเป็น IDN (analytics.ไข่เค็มไชยา.com) — ต้องใส่เป็น punycode
# เพราะ Telegram ไม่รับ URL ที่มีอักษรไทยตรง ๆ
PUBLIC_URL=https://analytics.xn--22ces5gg0h4d4ae2ai.com

# สุ่มยาว ๆ: openssl rand -hex 32   (ใช้เฉพาะเมื่อ TELEGRAM_MODE=webhook)
WEBHOOK_SECRET=

# ─── PIN ของ Dashboard สรุปเดือน ─────────────────────────────────────────────
# ลิงก์สรุปเดือนถูกพิมพ์เป็นข้อความในแชทเพื่อให้ forward ต่อได้ (Telegram ตัดปุ่ม
# web_app ทิ้งเวลา forward) — ลิงก์ที่ส่งต่อได้ก็คือลิงก์ที่หลุดไปไหนก็ได้
# เพราะงั้นข้อมูลอยู่หลัง PIN ตัวเดียวใช้ร่วมกันทุกเว็บ
#
# สร้าง hash:  npm run hash:pin        (พิมพ์ PIN แล้วเอาบรรทัดที่ได้มาใส่ที่นี่)
# ตรวจว่าตรง:  npm run hash:pin -- --verify
# ห้ามใส่ PIN ตรง ๆ ตรงนี้ — ค่าที่ใส่ต้องขึ้นต้นด้วย scrypt$ เท่านั้น
# ถ้าไม่ตั้งค่านี้ หน้า dashboard จะไม่เปิดให้ใครเลย (fail closed) ไม่ใช่เปิดฟรี
DASHBOARD_PIN_HASH=

# กรอก PIN ถูกครั้งเดียวแล้วจำไว้กี่ชั่วโมง
DASHBOARD_SESSION_HOURS=12
# กรอกผิดติดกันกี่ครั้งถึงล็อก และล็อกนานกี่นาที (กัน brute-force)
DASHBOARD_PIN_MAX_ATTEMPTS=5
DASHBOARD_PIN_LOCKOUT_MINUTES=15
# ลิงก์สรุปเดือนที่ส่งต่อไปแล้วใช้ได้กี่วัน (ครบแล้วต้องสั่งสรุปเดือนใหม่)
MONTHLY_LINK_DAYS=60

# ─── Session (spec §5) ───────────────────────────────────────────────────────
SESSION_IDLE_MINUTES=20
SQLITE_PATH=./data/sessions.sqlite

# ─── File ingestion (spec §3B) ───────────────────────────────────────────────
# ไม่ใช้ Google Sheets/Drive แล้ว — user อัปโหลดไฟล์ Excel ดิบเข้าบอทเองทุกสิ้นเดือน
# ไม่ต้องตั้งค่าอะไรเพิ่มปกติ ค่า default ใช้ได้เลย
DATA_DIR=./DATA
RAW_FILE_RETENTION_MONTHS=6

# ─── Google (เก็บที่ว่างไว้เผื่ออนาคต — ไม่มีโค้ดจุดไหนใน repo นี้อ่านค่าพวกนี้แล้ว) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
