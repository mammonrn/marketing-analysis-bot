# ads-analytics-bot — environment template
# คัดลอกเป็น .env บน VPS แล้วเติมค่าจริง (ห้าม commit .env)

# ─── Telegram ────────────────────────────────────────────────────────────────
# คนละ token กับ telegram-ads-bot (Project 1)
TELEGRAM_BOT_TOKEN=

# polling = ง่ายสุด ไม่ต้องแตะ Nginx เพิ่ม / webhook = ประหยัด resource กว่า
# ถ้าใช้ webhook ต้องตั้ง PUBLIC_URL + WEBHOOK_SECRET ด้วย
TELEGRAM_MODE=polling

# ─── Access control (spec §8) ────────────────────────────────────────────────
SUPER_ADMIN_TELEGRAM_ID=509832984
# ทีมที่อนุญาตเพิ่ม คั่นด้วย comma — Super Admin ถูกใส่ให้อัตโนมัติอยู่แล้ว
# เพิ่มคนใหม่ = แก้บรรทัดนี้ + pm2 restart ads-analytics-bot (ไม่ต้อง deploy โค้ดใหม่)
ALLOWED_TELEGRAM_IDS=

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4096

# ─── HTTP / Mini App ─────────────────────────────────────────────────────────
# Nginx ที่มีอยู่แล้ว proxy มาที่ port นี้
PORT=3001
BIND_HOST=127.0.0.1

# โดเมนเป็น IDN (analytics.ไข่เค็มไชยา.com) — ต้องใส่เป็น punycode
# เพราะ Telegram ไม่รับ URL ที่มีอักษรไทยตรง ๆ
PUBLIC_URL=https://analytics.xn--22ces5gg0h4d4ae2ai.com

# สุ่มยาว ๆ: openssl rand -hex 32   (ใช้เฉพาะเมื่อ TELEGRAM_MODE=webhook)
WEBHOOK_SECRET=

# ─── Session (spec §5) ───────────────────────────────────────────────────────
SESSION_IDLE_MINUTES=20
SQLITE_PATH=./data/sessions.sqlite

# ─── Google Sheets / Drive (read-only, credential เดียวกับ Project 1) ────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# แผนผัง spreadsheet ต่อเว็บ — ต้องกรอกให้ตรงกับ Sheets ที่ Project 1 เขียนไว้
# key ใช้ชื่อ canonical: shwe666 / ubet89 / 88fed
# ตัวอย่าง (แทน <ID> และชื่อแท็บด้วยของจริง):
# SHEETS_CONFIG={"shwe666":{"spreadsheetId":"<ID>","tabs":{"daily":"Daily","newMember":"Daily (1st New & 1st)","count":"Daily (Count)","brandValue":"Brand Value","vip":"Vip"}},"ubet89":{"spreadsheetId":"<ID>","tabs":{"daily":"Daily"}},"88fed":{"spreadsheetId":"<ID>","tabs":{"daily":"Daily"}}}
SHEETS_CONFIG=

# TTL cache ของข้อมูล Sheets (วินาที) — ลด API call ระหว่าง session เดียวกัน
SHEETS_CACHE_TTL_SECONDS=300

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info
