node_modules/
.env
.env.*
!.env.example

# session store (SQLite) — runtime state, never commit
# NOTE: root-anchored (`/data/`) on purpose — a bare `data/` also matches
# `src/data/` and silently swallowed that whole module once already.
/data/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# raw Excel files uploaded by users (spec §3B) — never commit, retained on disk only
/DATA/

logs/
*.log
npm-debug.log*
.DS_Store
